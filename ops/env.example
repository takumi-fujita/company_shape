# 認証情報と設定の雛形。
#
# Docker で回す場合（既定）:
#   cp ops/env.example .env      # リポジトリ直下。.gitignore 済み
#   $EDITOR .env
#   docker compose up -d
#
# 手元で直接回す場合:
#   mkdir -p ~/.config/kaisha-no-katachi
#   cp ops/env.example ~/.config/kaisha-no-katachi/env
#   chmod 600 ~/.config/kaisha-no-katachi/env
#
# ops/daily-update.sh は ~/.config/kaisha-no-katachi/env があれば読む
# （KAISHA_ENV_FILE で場所を変えられる）。コンテナでは compose の env_file から入る。

# --- 取り込み（必須） ---------------------------------------------------------
# 有価証券報告書。https://api.edinet-fsa.go.jp/ で購読キーを発行する。
# 無いと ETL は何も取り込めない。
EDINET_API_KEY=

# --- 取り込み（任意） ---------------------------------------------------------
# 補助金の交付決定。https://info.gbiz.go.jp/ でトークンを発行する。
# 無い場合は警告を出して補助金だけスキップし、有報のデータはそのまま入る。
GBIZINFO_API_TOKEN=

# AI 要約。https://console.anthropic.com/ で発行する。
# 無い場合は要約をスキップし、AI 要約カードはセクションごと非表示になる。
ANTHROPIC_API_KEY=

# --- 配信（必須。無ければ配信だけスキップされる） -----------------------------
# Cloudflare の「My Profile → API Tokens」で
# Account → Cloudflare Pages → Edit のテンプレートから作る。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# canonical / sitemap / JSON-LD に入る絶対 URL。
# Cloudflare Pages のカスタムドメインと一致させること。
NEXT_PUBLIC_SITE_URL=https://kaisha-no-katachi.jp

# --- git（コンテナから push する場合） ----------------------------------------
# リポジトリをマウントせず clone させるときだけ指定する。
# GIT_REMOTE=https://github.com/USER/kaisha-no-katachi.git

# HTTPS で push するためのトークン（repo 権限）。
# SSH 鍵を /root/.ssh にマウントする運用ならこちらは不要。
# GIT_TOKEN=

# GIT_AUTHOR_NAME=kaisha-no-katachi-bot
# GIT_AUTHOR_EMAIL=bot@kaisha-no-katachi.invalid

# --- 省略可 -------------------------------------------------------------------
# CF_PAGES_PROJECT=kaisha-no-katachi
# DEPLOY_BRANCH=main
# SKIP_DEPLOY=false            # true にするとデータ更新だけ行い配信しない
# MAX_SHRINK_PERCENT=5         # 会社数がこの割合を超えて減ったら止める
# PYTHON=python3
