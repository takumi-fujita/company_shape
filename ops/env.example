# ETL の認証情報の雛形。
#
# これをコピーして使う。リポジトリには実体を置かない。
#
#   mkdir -p ~/.config/kaisha-no-katachi
#   cp ops/env.example ~/.config/kaisha-no-katachi/env
#   chmod 600 ~/.config/kaisha-no-katachi/env
#   $EDITOR ~/.config/kaisha-no-katachi/env
#
# ops/daily-update.sh がこのファイルを読む（KAISHA_ENV_FILE で場所を変えられる）。
# launchd の plist にキーを書かないのは、plist が平文で誰にでも読めるため。

# --- 必須 --------------------------------------------------------------------
# 有価証券報告書の取得。https://api.edinet-fsa.go.jp/ で購読キーを発行する。
# 無いと ETL は何も取り込めない（終了コード 2）。
export EDINET_API_KEY=

# --- 任意 --------------------------------------------------------------------
# 補助金の交付決定。https://info.gbiz.go.jp/ でトークンを発行する。
# 無い場合は警告を出して補助金だけスキップし、有報のデータはそのまま入る。
export GBIZINFO_API_TOKEN=

# AI 要約。https://console.anthropic.com/ で発行する。
# 無い場合は要約をスキップし、AI 要約カードはセクションごと非表示になる。
export ANTHROPIC_API_KEY=

# --- 省略可 ------------------------------------------------------------------
# push 先のブランチ。既定は main。
# export DEPLOY_BRANCH=main

# 前回より会社数がこの割合を超えて減っていたら配信を止める（%）。既定は 5。
# export MAX_SHRINK_PERCENT=5

# 使う python。既定は python3。
# export PYTHON=/opt/homebrew/bin/python3.12
