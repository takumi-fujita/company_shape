# 認証情報と設定の雛形。
#
# Docker で回す場合（既定）:
#   cp ops/env.example .env      # リポジトリ直下。.gitignore 済み
#   （.env をエディタで開いて記入する）
#   docker compose up -d
#
# 手元で直接回す場合:
#   mkdir -p ~/.config/company-shape
#   cp ops/env.example ~/.config/company-shape/env
#   chmod 600 ~/.config/company-shape/env
#
# ops/daily-update.sh は ~/.config/company-shape/env があれば読む
# （COMPANY_SHAPE_ENV_FILE で場所を変えられる）。コンテナでは compose の env_file から入る。

# --- 取り込み（必須） ---------------------------------------------------------
# 有価証券報告書。https://api.edinet-fsa.go.jp/ で購読キーを発行する。
# 無いと ETL は何も取り込めない。
EDINET_API_KEY=

# --- 取り込み（任意） ---------------------------------------------------------
# 補助金の交付決定。https://info.gbiz.go.jp/ でトークンを発行する。
# 無い場合は警告を出して補助金だけスキップし、有報のデータはそのまま入る。
GBIZINFO_API_TOKEN=

# AI 要約。https://console.anthropic.com/ で発行する。
# 無い場合は要約をスキップし、AI 要約カードはセクションごと非表示になる。
ANTHROPIC_API_KEY=

# --- 配信（必須。無ければ配信だけスキップされる） -----------------------------
# Cloudflare の「My Profile → API Tokens」で
# Account → Cloudflare Pages → Edit のテンプレートから作る。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 訂正・削除依頼を受け付ける Google フォームの URL。
# 未設定でもページは出るが、フォームのボタンは出ない。
NEXT_PUBLIC_REMOVAL_FORM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# canonical / sitemap / JSON-LD に入る絶対 URL。**必須。**
# 既定値は用意していない。未設定のままビルドすると例外で止まる。
# Cloudflare Pages のカスタムドメインと一致させること。
NEXT_PUBLIC_SITE_URL=

# --- git（コンテナから push する場合） ----------------------------------------
# コンテナは無人で動くので、対話プロンプトが出た時点で詰む。
# origin の形式に合わせて、下のどれか 1 つを必ず用意すること。
# 用意が無い場合は起動時に「何をすればよいか」を出して止まる。
#
#   A. origin が SSH（git@github.com:USER/REPO.git）
#      → 鍵のあるディレクトリを絶対パスで指定する。compose は ~ を展開しない。
#         コンテナは読み取り専用でマウントし、書ける場所へコピーして権限を直す。
# GIT_SSH_DIR=/Users/you/.ssh
#
#   B. origin が HTTPS（https://github.com/USER/REPO.git）
#      → repo 権限のトークンを渡す。
# GIT_TOKEN=
#
#   C. push しない（データ更新と配信だけ行う）
# SKIP_PUSH=false

# リポジトリをマウントせず clone させるときだけ指定する。
# GIT_REMOTE=https://github.com/USER/company_shape.git

# GIT_AUTHOR_NAME=company-shape-bot
# GIT_AUTHOR_EMAIL=bot@company-shape.invalid

# エラーメッセージに出すホスト側のホームディレクトリ（案内文の見た目だけの用途）。
# HOST_HOME=/Users/you

# --- 省略可 -------------------------------------------------------------------
# CF_PAGES_PROJECT=company-shape
# DEPLOY_BRANCH=main
# SKIP_DEPLOY=false            # true にするとデータ更新だけ行い配信しない
# MAX_SHRINK_PERCENT=5         # 会社数がこの割合を超えて減ったら止める
# PYTHON=python3
