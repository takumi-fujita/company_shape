# フロントのビルド時設定の雛形。
#
#   cp apps/web/.env.example apps/web/.env.local
#
# 本番（GitHub Actions）では Repository variables の SITE_URL から渡す。
# ここに秘密情報は置かない。NEXT_PUBLIC_ 付きの値はビルド成果物に埋め込まれる。

# canonical / sitemap / JSON-LD に入る絶対 URL。
# Cloudflare Pages のカスタムドメインと一致させること（ずれると canonical が食い違う）。
NEXT_PUBLIC_SITE_URL=https://kaisha-no-katachi.jp

# ビルド時に読む SQLite の場所。既定は <repo>/data/companies.db。
# ETL の出力でフロントを検証したいときだけ使う。
# COMPANIES_DB=/tmp/synthetic.db
